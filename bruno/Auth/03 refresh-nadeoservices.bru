meta {
  name: Refresh (NadeoServices)
  type: http
  seq: 3
}

post {
  url: https://prod.trackmania.core.nadeo.online/v2/authentication/token/refresh
  body: none
  auth: none
}

headers {
  Authorization: nadeo_v1 t={{refresh_token_nadeoservices}}
  User-Agent: COTDLiveQualifying / KuebelChris
}

docs {
  Refreshes the NadeoServices access token without re-authenticating.
  Access tokens expire after ~1 hour; refresh tokens are valid for ~1 day.
  On success, updates access_token_nadeoservices and refresh_token_nadeoservices in the environment.
}

script:post-response {
  const data = res.getBody();
  if (data && data.accessToken) {
    bru.setEnvVar("access_token_nadeoservices", data.accessToken);
    bru.setEnvVar("refresh_token_nadeoservices", data.refreshToken);
  }
}
