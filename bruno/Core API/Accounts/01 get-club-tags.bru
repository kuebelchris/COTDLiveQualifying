meta {
  name: Get Club Tags
  type: http
  seq: 1
}

get {
  url: https://prod.trackmania.core.nadeo.online/accounts/clubTags/?accountIdList={{account_id}}
  body: none
  auth: none
}

docs {
  Gets the active club tag for one or more players by account ID.
  The tag is what's shown in-game next to the player name on leaderboards.

  For multiple accounts use a comma-separated list:
    accountIdList=id1,id2,id3
  or the array format:
    accountIdList[]=id1&accountIdList[]=id2

  Limit: ~200 account IDs per request (URI length limit of ~8220 chars).
  Requires NadeoServices token from a Ubisoft account (not a dedicated server account).
}
