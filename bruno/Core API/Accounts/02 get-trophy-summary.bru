meta {
  name: Get Trophy Summary
  type: http
  seq: 2
}

get {
  url: https://prod.trackmania.core.nadeo.online/accounts/{{account_id}}/trophies/lastYearSummary
  body: none
  auth: none
}

docs {
  Gets the last 12 months trophy summary for a player.
  Returns total trophy points and per-tier counts (t1–t9).
  Trophy points determine a player's global and regional rank.

  Requires NadeoServices token from a Ubisoft account (not a dedicated server account).
}
