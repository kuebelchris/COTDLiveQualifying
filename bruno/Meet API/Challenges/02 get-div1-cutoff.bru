meta {
  name: Get Div 1 Cutoff Time
  type: http
  seq: 2
}

get {
  url: https://meet.trackmania.nadeo.club/api/challenges/{{challenge_id}}/records/maps/{{map_id}}
  body: none
  auth: none
}

query {
  offset: 63
  length: 1
}

docs {
  Gets the record at rank 64 — the Div 1 cutoff time.
  The top 64 players qualify for Div 1; rank 64 is the last qualifying spot.

  Response fields:
    [0].score  → cutoff time in milliseconds
    [0].rank   → should be 64
    [0].player → accountId of the player at that exact rank

  Set challenge_id and map_id in the environment before running.
}
