meta {
  name: Meet API
}

headers {
  Authorization: nadeo_v1 t={{access_token_nadeoliveservices}}
  User-Agent: COTDLiveQualifying / KuebelChris
}

docs {
  Base URL: https://meet.trackmania.nadeo.club
  Audience: NadeoLiveServices

  Covers competitions, COTD, matchmaking, and challenges.
  Run "Authenticate (NadeoLiveServices)" first to populate the access token.
}
