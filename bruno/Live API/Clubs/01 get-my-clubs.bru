meta {
  name: Get My Clubs
  type: http
  seq: 1
}

get {
  url: https://live-services.trackmania.nadeo.live/api/token/club/mine?offset=0&length=100
  body: none
  auth: none
}

docs {
  Gets all clubs the authenticated player is a member of.
  Paginated — max 100 per page. Increase offset to get subsequent pages.
  Returns club IDs, names, and tags. Used by COTDLiveQualifying to populate
  the Club Picker settings tab.
}
