meta {
  name: Get Club Members
  type: http
  seq: 3
}

get {
  url: https://live-services.trackmania.nadeo.live/api/token/club/{{club_id}}/member?offset=0&length=100
  body: none
  auth: none
}

docs {
  Gets the member list for a specific club.
  Paginated — max 100 per page. Adjust offset for subsequent pages.
  Returns accountId for each member — used by COTDLiveQualifying for
  tracking all members during COTD qualifying.

  Set club_id in the Trackmania environment before running.
  Response fields: clubMemberList[].accountId, itemCount, maxPage
}
