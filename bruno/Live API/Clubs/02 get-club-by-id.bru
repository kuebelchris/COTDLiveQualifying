meta {
  name: Get Club by ID
  type: http
  seq: 2
}

get {
  url: https://live-services.trackmania.nadeo.live/api/token/club/{{club_id}}
  body: none
  auth: none
}

docs {
  Gets details for a specific club by its numeric ID.
  Returns name, tag, member count, and media assets.

  Set club_id in the Trackmania environment before running.
}
